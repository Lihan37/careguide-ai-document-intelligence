# Run scripts/init_reviewer_env.py to create an ignored .env with unique credentials.
DATABASE_URL=sqlite:///./data/careguide.db
APP_ENV=development
REDIS_URL=redis://localhost:6379/0
EXECUTION_MODE=local
EXTRACTION_MODE=deterministic_demo
STORAGE_DIR=./data/uploads
# Required values are generated per checkout. Keep them blank in this example.
SESSION_SECRET=
POSTGRES_PASSWORD=
DEMO_USERNAME=reviewer
DEMO_PASSWORD=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
MAX_LLM_CHUNKS=100
# Set EXTRACTION_MODE=gemini_auto (selective) or gemini (every document).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_REQUESTS=6
GEMINI_MAX_OUTPUT_TOKENS=4096
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDINGS_ENABLED=false
# Select local for CPU inference without an API key, or openai for an existing provider.
EMBEDDING_PROVIDER=local
EMBEDDING_CACHE_DIR=./data/embedding-models
TESSERACT_CMD=
TESSERACT_DATA_DIR=
OCR_LANGUAGE=eng
OCR_REVIEW_THRESHOLD=0.80
MAX_FILE_MB=30
MAX_UPLOAD_FILES=10
MAX_PAGES=1200
MAX_CELLS=200000
MAX_IMAGE_PIXELS=25000000
OCR_TIMEOUT=30
JOB_TIMEOUT=3600
CORS_ORIGIN=http://localhost:3000
# The frontend reads this from its process environment or apps/web/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional backend override: CURRENCY_TOLERANCES={"JPY":"1","BHD":"0.001"}
# Optional Compose host ports: CAREGUIDE_API_PORT=8000, CAREGUIDE_POSTGRES_PORT=5432, CAREGUIDE_REDIS_PORT=6379
